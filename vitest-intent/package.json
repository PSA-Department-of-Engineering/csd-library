{
  "name": "vitest-intent",
  "version": "0.1.0",
  "description": "Vitest+TypeScript implementation of CSD's Intent Specification annotation pattern. Provides intent() wrapper + meta-tests enforcing intent.yaml schema and intent-test coverage.",
  "keywords": [
    "vitest",
    "intent",
    "csd",
    "testing",
    "specification",
    "tdd"
  ],
  "license": "MIT",
  "author": "Rafael Pires",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafael-pires/vitest-intent"
  },
  "homepage": "https://github.com/rafael-pires/vitest-intent#readme",
  "bugs": {
    "url": "https://github.com/rafael-pires/vitest-intent/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./meta-tests": {
      "import": "./dist/meta-tests.js",
      "types": "./dist/meta-tests.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vitest": ">=1.0.0"
  },
  "dependencies": {
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
