{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "separator": "-",
  "packages": {
    "vitest-intent": {
      "release-type": "node",
      "component": "vitest-intent"
    },
    "playwright-intent": {
      "release-type": "node",
      "component": "playwright-intent"
    },
    "starlight-theme": {
      "release-type": "node",
      "component": "starlight-theme"
    },
    "pytest-intent": {
      "release-type": "python",
      "component": "pytest-intent",
      "extra-files": [
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" }
      ]
    },
    "csd-intent": {
      "release-type": "python",
      "component": "csd-intent",
      "extra-files": [
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" }
      ]
    }
  }
}
