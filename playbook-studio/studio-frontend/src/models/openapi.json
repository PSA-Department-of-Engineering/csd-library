{
  "openapi": "3.1.0",
  "info": {
    "title": "playbook-studio API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Report service liveness and version.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/graph": {
      "get": {
        "tags": [
          "graph"
        ],
        "summary": "Get Graph",
        "description": "Return the full playbook reference graph.",
        "operationId": "get_graph_api_graph_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/playbook": {
      "get": {
        "tags": [
          "playbook"
        ],
        "summary": "Get Playbook",
        "description": "Return AI-PLAYBOOK.md parsed into titled sections.",
        "operationId": "get_playbook_api_playbook_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybookResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/refs/{name}": {
      "get": {
        "tags": [
          "refs"
        ],
        "summary": "Get Ref",
        "description": "Return one parsed REF by name (e.g. REF-Python).",
        "operationId": "get_ref_api_refs__name__get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/refs/{name}/sections/{number}": {
      "put": {
        "tags": [
          "refs"
        ],
        "summary": "Update Ref Section",
        "description": "Write a section body; the edit survives only if the validation gates pass.",
        "operationId": "update_ref_section_api_refs__name__sections__number__put",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims": {
      "get": {
        "tags": [
          "claims"
        ],
        "summary": "List Claims",
        "description": "Return every claim in the playbook's intent.yaml.",
        "operationId": "list_claims_api_claims_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IntentClaimResponse"
                  },
                  "type": "array",
                  "title": "Response List Claims Api Claims Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/validate": {
      "post": {
        "tags": [
          "validation"
        ],
        "summary": "Run Validation",
        "description": "Run the playbook's intent tests + link checker and return the report.",
        "operationId": "run_validation_api_validate_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationReportResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GraphNodeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "label",
          "domain"
        ],
        "title": "GraphNodeResponse",
        "description": "A playbook graph node returned over HTTP."
      },
      "GraphResponse": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/GraphNodeResponse"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/ReferenceEdgeResponse"
            },
            "type": "array",
            "title": "Edges"
          }
        },
        "type": "object",
        "required": [
          "nodes",
          "edges"
        ],
        "title": "GraphResponse",
        "description": "The full playbook node/edge graph returned over HTTP."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Service liveness and version."
      },
      "IntentClaimResponse": {
        "properties": {
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "statement": {
            "type": "string",
            "title": "Statement"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          },
          "criticality": {
            "type": "string",
            "title": "Criticality"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "claim_id",
          "statement",
          "rationale",
          "criticality",
          "status"
        ],
        "title": "IntentClaimResponse",
        "description": "An intent.yaml claim returned over HTTP."
      },
      "PlaybookResponse": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/PlaybookSectionResponse"
            },
            "type": "array",
            "title": "Sections"
          }
        },
        "type": "object",
        "required": [
          "title",
          "sections"
        ],
        "title": "PlaybookResponse",
        "description": "The parsed AI-PLAYBOOK.md returned over HTTP."
      },
      "PlaybookSectionResponse": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "title": "PlaybookSectionResponse",
        "description": "A titled AI-PLAYBOOK.md section returned over HTTP."
      },
      "RefDetailResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/RefSectionResponse"
            },
            "type": "array",
            "title": "Sections"
          }
        },
        "type": "object",
        "required": [
          "name",
          "domain",
          "title",
          "summary",
          "sections"
        ],
        "title": "RefDetailResponse",
        "description": "A parsed REF returned over HTTP."
      },
      "RefSectionResponse": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "generated": {
            "type": "boolean",
            "title": "Generated"
          }
        },
        "type": "object",
        "required": [
          "number",
          "title",
          "body",
          "generated"
        ],
        "title": "RefSectionResponse",
        "description": "A numbered REF section returned over HTTP."
      },
      "ReferenceEdgeResponse": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "source",
          "target",
          "kind"
        ],
        "title": "ReferenceEdgeResponse",
        "description": "A directed reference edge returned over HTTP."
      },
      "UpdateSectionRequest": {
        "properties": {
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "body"
        ],
        "title": "UpdateSectionRequest",
        "description": "The new markdown body for one REF section."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValidationReportResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "tests_passed": {
            "type": "boolean",
            "title": "Tests Passed"
          },
          "links_ok": {
            "type": "boolean",
            "title": "Links Ok"
          },
          "tests_output": {
            "type": "string",
            "title": "Tests Output"
          },
          "links_output": {
            "type": "string",
            "title": "Links Output"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "tests_passed",
          "links_ok",
          "tests_output",
          "links_output"
        ],
        "title": "ValidationReportResponse",
        "description": "Outcome of the playbook's validation gates returned over HTTP."
      }
    }
  }
}
