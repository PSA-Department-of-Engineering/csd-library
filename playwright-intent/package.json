{
  "name": "@psa-department-of-engineering/playwright-intent",
  "version": "2.0.1",
  "description": "The intent() wrapper for Playwright - links an e2e test to one or more CSD intent claims (INT-NNN). Spec validation and cross-runtime coverage live in the standalone `csd-intent` CLI.",
  "keywords": [
    "playwright",
    "intent",
    "csd",
    "testing",
    "specification",
    "e2e"
  ],
  "license": "MIT",
  "author": "Rafael Pires",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PSA-Department-of-Engineering/csd-library.git",
    "directory": "playwright-intent"
  },
  "homepage": "https://github.com/PSA-Department-of-Engineering/csd-library/tree/main/playwright-intent#readme",
  "bugs": {
    "url": "https://github.com/PSA-Department-of-Engineering/csd-library/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
